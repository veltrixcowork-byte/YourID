NODE_ENV=production
PORT=4000
APP_URL=https://yourid.vercel.app
API_URL=https://api.yourid.example.com
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.tidcloud.io:5432/yourid?sslmode=require
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
UPLOAD_DIR=/tmp/yourid-uploads
PLATFORM_FEE_PERCENT=15
OPENAI_API_KEY=replace_me
RESEND_API_KEY=replace_me
