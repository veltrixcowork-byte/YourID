{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "plugins": ["@nestjs/swagger"],
    "assets": [{ "include": "database/schema.sql", "outDir": "dist" }]
  }
}
